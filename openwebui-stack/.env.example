# Public URL (must match the browser). Also Portainer --trusted-origins
WEBUI_URL=https://IP_ADDRESS

# PostgreSQL
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=PasswordChangeMe

# SeaweedFS S3 (same keys in s3.json)
S3_BUCKET_NAME=openwebui
S3_ACCESS_KEY=API_KEY_ChangeMe
S3_SECRET_KEY=S3ChangeMe

# Qdrant API (same value in nginx snippet qdrant-apikey.conf)
QDRANT_API_KEY=API_KEY_ChangeMe

# LM Studio OpenAI-compatible API on the inference host
LMSTUDIO_URL=http://IP_ADDRESS:1234/v1
LMSTUDIO_API_KEY=API_KEY_ChangeMe

# BGE-M3: RU + EN/DE/FR/ES + ZH, dim 1024
EMBEDDING_MODEL=text-embedding-bge-m3

# Optional overlay only (docker-compose.rerank.yml). Default stack has no rerank.
# Filename under rerank/models/ — not EMBEDDING_MODEL.
# RERANK_GGUF=model.gguf
# RERANK_MODEL=bge-reranker-v2-m3

# --- Images (optional). Defaults are stock upstream tags in docker-compose.yml.
# To run a newer version brought into an air-gapped host: docker load it, then set the tag here
# (or keep the same tag) and run ./update-stack.sh --offline.
# OPENWEBUI_IMAGE=openwebui/open-webui:latest
# POSTGRES_IMAGE=postgres:17-alpine
# QDRANT_IMAGE=qdrant/qdrant:v1.15.4
# VALKEY_IMAGE=valkey/valkey:8-alpine
# SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.92
# TIKA_IMAGE=apache/tika:4.0.0-full
# PORTAINER_IMAGE=portainer/portainer-ce:latest
# RERANK_IMAGE=ghcr.io/ggml-org/llama.cpp:server
